@{
    ViewBag.Title = "Контакти";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <h1>📞 Контакти</h1>
    <p>Свържете се с нас за поръчки и въпроси</p>
</div>

<div class="contact-page container">

    @if (!string.IsNullOrEmpty(ViewBag.Message))
    {
        <div style="background:#d4edda; border:2px solid #28a745; padding:15px 20px; border-radius:8px; margin-bottom:30px; color:#155724;">
            ✅ @ViewBag.Message
        </div>
    }

    <div class="contact-grid">

        <!-- Информация -->
        <div class="contact-info">
            <h3>Намерете ни</h3>

            <div class="contact-item">
                <span class="icon">📍</span>
                <p>с. Пчелово, обл. Пловдив<br>България, 4200</p>
            </div>

            <div class="contact-item">
                <span class="icon">📞</span>
                <p>+359 888 123 456<br>Пон – Пет: 09:00 – 18:00</p>
            </div>

            <div class="contact-item">
                <span class="icon">✉️</span>
                <p>info@pchelen-raj.bg</p>
            </div>

            <div class="contact-item">
                <span class="icon">🕐</span>
                <p>Работно време:<br>Пон – Пет: 09:00 – 18:00<br>Събота: 10:00 – 14:00</p>
            </div>
        </div>

        <!-- Форма за контакт -->
        <div class="contact-form">
            <h3>Изпратете съобщение</h3>

            @using (Html.BeginForm("Contact", "Home", FormMethod.Post))
            {
                <div class="form-group">
                    <label for="name">Вашето име</label>
                    <input type="text" id="name" name="name" placeholder="Иван Иванов" required />
                </div>

                <div class="form-group">
                    <label for="email">Имейл адрес</label>
                    <input type="email" id="email" name="email" placeholder="ivan@example.com" required />
                </div>

                <div class="form-group">
                    <label for="message">Съобщение</label>
                    <textarea id="message" name="message" placeholder="Напишете вашето съобщение или поръчка тук..." required></textarea>
                </div>

                <button type="submit" class="btn-submit">📨 Изпрати съобщение</button>
            }
        </div>

    </div>
</div>
